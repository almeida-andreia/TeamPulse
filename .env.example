# Copy to .env for local development; use injected variables on a server.
# Never commit .env or real credentials. Values here are examples only.
# Local application defaults
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Render: NODE_ENV=production, HOST=0.0.0.0; let Render supply PORT.
# Pin a tested NODE_VERSION in Render as documented in DEPLOYMENT.md.
# Explicitly enable fictional, password-free MVP accounts (including remote access).
# Production defaults to disabled when this variable is absent. Never use with real data.
DEMO_AUTH_ENABLED=true
TRUST_PROXY=false
# Render managed ingress: TRUST_PROXY=1 (immediate proxy only). See DEPLOYMENT.md.
# Use only when the proxy controls forwarded headers and the listener has no public bypass.

# PostgreSQL: all five connection variables are required; DATABASE_URL is not used.
# Local example below: replace values privately for your available PostgreSQL server.
# Neon/Render: DB_HOST is the Neon hostname only (no URL, user or password).
# Use the endpoint's supplied DB_PORT (normally 5432), DB_NAME and DB_USER.
# Keep DB_PASSWORD private; inject production values through Render's secret settings.
# Use Neon's direct endpoint for maintenance/initialization; see DEPLOYMENT.md for pooling.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=teampulse
DB_USER=
DB_PASSWORD=
DB_SSL=false
# Neon: set DB_SSL=true. false above is only the local PostgreSQL example.
# TLS verifies the server certificate. A publicly trusted CA needs no custom file.
# Optional DB_SSL_CA_FILE: readable CA certificate, absolute or relative to this repo.
# Use only if the administrator requires a custom CA; never disable verification.
# DB_SSL_CA_FILE=/path/to/postgresql-ca.pem
# DB_POOL_MAX limits this process's pg pool (1-100; default 5), including with Neon.
DB_POOL_MAX=5

# Approved demo threshold; not changed by setup, seed or startup.
MIN_RESPONSES=5

# SESSION_SECRET is optional in development (random fallback); REQUIRED in production.
# Production requires at least 32 characters generated from secure random bytes.
# Generate with node:crypto randomBytes(32).toString('base64'). Do not reuse examples.
SESSION_SECRET=

# Explicit fictional Demo Access permits the existing single-instance memory sessions.
# Ordinary production without Demo Access requires a persistent session-store integration.
